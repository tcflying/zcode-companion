+/** 閫犱竴涓鍑哄櫒锛宍saveAs` 涓?`writeFile` 閮芥槸鍙帶妗╋紝鍐欏叆鐩爣鐢辨祴璇曟寚瀹氬湪绉佹湁涓存椂鐩綍鍐呫€?*/
+function makeExporter({ dir, lines, secrets = [], saveAs, now = FIXED_NOW }) {
+  const writes = [];
+  const run = createLogExporter({
+    getLines: () => lines,
